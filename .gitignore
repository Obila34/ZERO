# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Models (downloaded via setup_pi.sh — too big for git)
models/
*.onnx
*.pth
*.bin
*.gguf
# ...except the bundled YOLO11n weights, which ship with the repo for offline use.
!yolo11n.onnx

# Local config overrides & debug audio
config.local.yaml
debug_*.wav
*.log

# Long-term memory store (per-device, not source)
*.sqlite
*.sqlite-journal

# Interaction corpus — day-to-day conversations captured for offline training.
# Per-device, may contain personal speech; never source.
data/corpus/

# Voiceprint profile (per-device)
voiceprint.npy
*.npy
!yolo11s.onnx
# ...and the open-vocabulary YOLO-World export (built via
# scripts/export_yolo_onnx.py --vocab). Its .names.json is tracked too (not
# matched by any ignore rule) so class ids map back to words on the Pi.
!yolov8s-worldv2.onnx
# The deployed Pi reflex eye (Phase 1): 480px open-vocab export.
!yolov8s-worldv2-480.onnx
# INT8 experiment artifacts (scripts/prune_models.py) — rebuildable, not shipped.
*-int8.names.json

# Runtime state (per-device, grows live — never source)
data/consolidation/
data/train/
data/world_surprise.json
server/vision/vocab.runtime.txt
server/vision/.cache/

# YOLO source weights (build artifacts; we ship the exported .onnx only)
*.pt

# joint-angle black box — runtime DB, never tracked
zero_joints.sqlite
zero_joints.sqlite-*
