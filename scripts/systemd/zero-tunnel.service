[Unit]
Description=ZERO SSH tunnel Pi -> GPU (LLM/STT/TTS/Vision)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=head
Environment=GPU_HOST=obilasam3@zerolabs1
Environment=AUTOSSH_GATETIME=0
ExecStart=/bin/bash /home/head/Mzee/ZERO/scripts/pi_tunnel.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
