[Unit]
Description=ZERO conversational robot (Pi main loop)
After=network-online.target zero-tunnel.service sound.target
Wants=network-online.target zero-tunnel.service

[Service]
Type=simple
User=head
WorkingDirectory=/home/head/Mzee/ZERO
ExecStart=/home/head/Mzee/ZERO/.venv/bin/python -m zero.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
