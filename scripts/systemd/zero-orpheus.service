[Unit]
Description=ZERO Orpheus TTS server (GPU)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=obilasam3
WorkingDirectory=/home/obilasam3/zero
ExecStart=/home/obilasam3/zero/.venv/bin/python server/orpheus_cpp_server.py --port 9100
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
