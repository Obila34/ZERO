[Unit]
Description=ZERO Vision server - depth + scene facts (GPU)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=obilasam3
WorkingDirectory=/home/obilasam3/ZERO/server/vision
ExecStart=/home/obilasam3/ZERO/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
