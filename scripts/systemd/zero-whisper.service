[Unit]
Description=ZERO Whisper STT server (GPU)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=obilasam3
WorkingDirectory=/home/obilasam3/ZERO
ExecStart=/home/obilasam3/ZERO/.venv/bin/python server/whisper_server.py --model deepdml/faster-whisper-large-v3-turbo-ct2 --port 9000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
